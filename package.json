{
  "name": "rom-manager-tui",
  "version": "1.0.0",
  "description": "Terminal user interface for managing ROM collections",
  "type": "module",
  "main": "src/index.tsx",
  "scripts": {
    "dev": "bun run src/index.tsx",
    "start": "bun run src/index.tsx",
    "build": "bun build src/index.tsx --outdir=dist",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "eslint src/ --max-warnings=0",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/ .github/ *.json *.md",
    "format:check": "prettier --check src/ .github/ *.json *.md",
    "type-check": "tsc --noEmit",
    "ci": "bun run gate:lint && bun run gate:typecheck && bun run format:check && bun run test",
    "gate:lint": "node scripts/gate-ratchet.mjs lint",
    "gate:typecheck": "node scripts/gate-ratchet.mjs typecheck"
  },
  "keywords": [
    "rom",
    "rom-manager",
    "tui",
    "terminal-ui",
    "retro-gaming",
    "emulation"
  ],
  "author": "AIntelligent Technologies",
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "8",
    "@typescript-eslint/parser": "8",
    "eslint": "10",
    "eslint-config-prettier": "10",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "8"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.0.0"
  }
}
