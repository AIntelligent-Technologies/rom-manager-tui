{
  "name": "rom-manager-tui",
  "version": "1.0.0",
  "description": "Terminal user interface for managing ROM collections",
  "type": "module",
  "main": "src/index.tsx",
  "scripts": {
    "dev": "bun run src/index.tsx",
    "start": "bun run src/index.tsx",
    "build": "bun build src/index.tsx --outdir=dist",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "eslint src/ --max-warnings=0",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/ .github/ *.json *.md",
    "format:check": "prettier --check src/ .github/ *.json *.md",
    "type-check": "tsc --noEmit",
    "ci": "bun run lint && bun run type-check && bun run format:check && bun run test"
  },
  "keywords": [
    "rom",
    "rom-manager",
    "tui",
    "terminal-ui",
    "retro-gaming",
    "emulation"
  ],
  "author": "AIntelligent Technologies",
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.5.0",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.0.0"
  }
}
